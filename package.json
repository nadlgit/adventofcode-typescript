{
  "name": "adventofcode-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest",
    "createday": "node scripts/create-day.js",
